# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
DRIVER_URL=http://localhost:5175

# ─── Database (PostgreSQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sakunna_gas
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── LINE ─────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_LIFF_ID=your_liff_id
LINE_LIFF_CLIENT_ID=your_liff_client_id
LINE_ADMIN_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Maps ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Shop Location (พิกัดร้านสกุณาแก๊ส) ──────────────────
SHOP_LAT=13.8720
SHOP_LNG=100.5780
SHOP_NAME=สกุณาแก๊ส

# ─── QR Payment ───────────────────────────────────────────
PROMPTPAY_NUMBER=0812345678
QR_IMAGE_URL=https://your-domain.com/qr-payment.png

# ─── Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
